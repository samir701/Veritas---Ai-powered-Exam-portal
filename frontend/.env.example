# URL of the deployed Node.js backend (used by Next.js /api/* proxy rewrites in next.config.mjs)
# In Vercel, set BACKEND_URL to your deployed backend Vercel URL (e.g. https://your-backend.vercel.app)
BACKEND_URL=http://127.0.0.1:4000

# Leave blank when proxying /api/* through Next.js rewrites (keeps cookies first-party on Vercel).
# Set only if calling the backend directly from the browser without Next.js rewrites.
NEXT_PUBLIC_API_BASE=

# Optional public Supabase credentials
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
