# Server
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Security & Sessions (set EXAM_PORTAL_COOKIE_SECURE=1 in HTTPS/Vercel production)
EXAM_PORTAL_SECRET=replace-with-a-random-64-char-hex-secret
EXAM_PORTAL_SESSION_HOURS=12
EXAM_PORTAL_INVITE_HOURS=72
EXAM_PORTAL_COOKIE_SECURE=0
EXAM_PORTAL_COOKIE_SAMESITE=Lax

# Rate Limits (requests per minute per IP)
EXAM_PORTAL_RATE_AUTH=25
EXAM_PORTAL_RATE_API=180

# Local SQLite fallback (used only when DATABASE_URL is blank)
EXAM_PORTAL_DB=./data/exam_portal.db

# Supabase PostgreSQL (required for Vercel deployment & Supabase migration)
# Paste your Supabase Session Pooler URI (Project Settings -> Database -> Connect -> Method: Session pooler)
DATABASE_URL=
DB_SSL=1

# Or provide individual connection parameters:
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# Optional Supabase API credentials
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq AI (for face tracking anti-cheat analysis)
GROQ_API_KEY=
